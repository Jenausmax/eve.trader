<Project>

  <!--
    Общие свойства всех проектов решения. Версии пакетов — в Directory.Packages.props.
    Гейт сборки описан в .agents/rules/process/build-verification.md:
    dotnet build EveTrader.slnx -c Debug — компиляция, анализаторы и format-проверка.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Любой warning валит сборку: правило analyzers.md §«Что делать при новом warning». -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA выключены целиком, кроме security-набора — analyzers.md §«Что активно». -->
    <AnalysisMode>None</AnalysisMode>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
